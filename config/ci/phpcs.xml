<?xml version="1.0"?>
<ruleset name="phpcs">
    <rule ref="/composer/vendor/steevanb/php-code-sniffs/src/Steevanb/ruleset.xml"/>
    <arg name="warning-severity" value="0"/>
    <exclude-pattern>/var</exclude-pattern>
    <exclude-pattern>/vendor</exclude-pattern>
    <arg name="report" value="Steevanb\PhpCodeSniffs\Reports\Steevanb"/>
    <arg name="cache" value="../../var/ci/phpcs/cache"/>
    <arg name="report" value="full"/>
    <file>../../</file>
    <rule ref="Squiz.Scope.MemberVarScope">
        <exclude name="Squiz.Scope.MemberVarScope"/>
    </rule>
    <rule ref="Steevanb.Uses.GroupUses">
        <properties>
            <property name="groupPrefixes" type="array" extend="true">
                <element value="PhpParser\Node"/>
                <element value="PHPStan\Analyser"/>
                <element value="PHPStan\Reflection"/>
                <element value="PHPStan\Rules"/>
                <element value="PHPStan\Testing"/>
                <element value="PHPUnit\Framework\Attributes"/>
                <element value="Steevanb\ParallelProcess"/>
                <element value="Steevanb\PhpCollection\ScalarCollection"/>
                <element value="Steevanb\PhpStanRules"/>
            </property>
        </properties>
    </rule>
</ruleset>
