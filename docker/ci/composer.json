{
    "require": {
        "ergebnis/composer-normalize": "2.53.0",
        "ergebnis/phpstan-rules": "2.13.1",
        "maglnet/composer-require-checker": "4.24.0",
        "phpstan/phpstan": "2.2.14",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-strict-rules": "2.0.12",
        "spaze/phpstan-disallowed-calls": "4.14.0",
        "steevanb/php-code-sniffs": "6.1.4",
        "steevanb/php-parallel-processes": "1.2.0"
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    }
}
